--
-- Test foreign keys with WHERE clauses
--
--
-- Basic setup
--
create type commentable_entity as enum ('blog', 'event');
create table blog (
	id int4 primary key
);
create table event (
	id int4 primary key
);
create table comment (
	id int4,
	parent_entity commentable_entity not null,
	parent_id int4 default 66
);
--
-- basic fk insertion / pk deletion / pk update with restrict
--
-- add constraints
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references blog(id)
	on delete restrict;
alter table comment add constraint comment_event_fk foreign key (parent_id)
	where (parent_entity = 'event')
	references event(id)
	on update restrict;
-- data setup
insert into blog values (10);
insert into event values (20);
insert into comment values(1, 'blog', 10);
insert into comment values(2, 'event', 20);
-- failing insert
insert into comment values(3, 'blog', 20); -- fails
ERROR:  insert or update on table "comment" violates foreign key constraint "comment_blog_fk"
DETAIL:  Key (parent_id)=(20) is not present in table "blog".
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        10
  2 | event         |        20
(2 rows)

-- delete of foreign key
delete from blog; -- fails
ERROR:  update or delete on table "blog" violates foreign key constraint "comment_blog_fk" on table "comment"
DETAIL:  Key (id)=(10) is still referenced from table "comment".
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        10
  2 | event         |        20
(2 rows)

-- update of foreign key
update event set id = 77; -- fails
ERROR:  update or delete on table "event" violates foreign key constraint "comment_event_fk" on table "comment"
DETAIL:  Key (id)=(20) is still referenced from table "comment".
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        10
  2 | event         |        20
(2 rows)

-- cleanup
delete from comment;
delete from blog;
delete from event;
alter table comment drop constraint comment_blog_fk;
alter table comment drop constraint comment_event_fk;
--
-- cascade deletions / updates
--
-- add constraints
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references blog(id)
	on delete cascade;
alter table comment add constraint comment_event_fk foreign key (parent_id)
	where (parent_entity = 'event')
	references event(id)
	on update cascade;
-- data setup
insert into blog values (10);
insert into blog values (20);
insert into comment values(1, 'blog', 10);
insert into comment values(2, 'blog', 20);
insert into event values (10);
insert into event values (20);
insert into comment values(3, 'event', 10);
insert into comment values(4, 'event', 20);
-- cascading update
update event set id = 22 where id = 20;
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        10
  2 | blog          |        20
  3 | event         |        10
  4 | event         |        22
(4 rows)

-- cascading delete
delete from blog where id = 10;
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  2 | blog          |        20
  3 | event         |        10
  4 | event         |        22
(3 rows)

-- cleanup
delete from comment;
delete from event;
delete from blog;
alter table comment drop constraint comment_blog_fk;
alter table comment drop constraint comment_event_fk;
--
-- set null
--
-- add constraints
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references blog(id)
	on delete set null;
alter table comment add constraint comment_event_fk foreign key (parent_id)
	where (parent_entity = 'event')
	references event(id)
	on update set null;
-- data setup
insert into blog values (10);
insert into blog values (20);
insert into comment values(1, 'blog', 10);
insert into comment values(2, 'blog', 20);
insert into event values (10);
insert into event values (20);
insert into comment values(3, 'event', 10);
insert into comment values(4, 'event', 20);
-- update
update event set id = 22 where id = 20;
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        10
  2 | blog          |        20
  3 | event         |        10
  4 | event         |          
(4 rows)

-- delete
delete from blog where id = 10;
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |          
  2 | blog          |        20
  3 | event         |        10
  4 | event         |          
(4 rows)

-- cleanup
delete from comment;
delete from event;
delete from blog;
alter table comment drop constraint comment_blog_fk;
alter table comment drop constraint comment_event_fk;
--
-- set default
--
-- add constraints
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references blog(id)
	on delete set default;
alter table comment add constraint comment_event_fk foreign key (parent_id)
	where (parent_entity = 'event')
	references event(id)
	on update set default;
-- data setup
insert into blog values (10);
insert into blog values (20);
insert into comment values(1, 'blog', 10);
insert into comment values(2, 'blog', 20);
insert into event values (10);
insert into event values (20);
insert into comment values(3, 'event', 10);
insert into comment values(4, 'event', 20);
-- update
update event set id = 22 where id = 20; -- fails
ERROR:  insert or update on table "comment" violates foreign key constraint "comment_event_fk"
DETAIL:  Key (parent_id)=(66) is not present in table "event".
insert into event values (66);
update event set id = 22 where id = 20;
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        10
  2 | blog          |        20
  3 | event         |        10
  4 | event         |        66
(4 rows)

-- delete
delete from blog where id = 10; -- fails
ERROR:  insert or update on table "comment" violates foreign key constraint "comment_blog_fk"
DETAIL:  Key (parent_id)=(66) is not present in table "blog".
insert into blog values (66);
delete from blog where id = 10;
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        66
  2 | blog          |        20
  3 | event         |        10
  4 | event         |        66
(4 rows)

-- cleanup
delete from comment;
delete from event;
delete from blog;
alter table comment drop constraint comment_blog_fk;
alter table comment drop constraint comment_event_fk;
--
-- no action with deferred constraints
--
-- add constraints
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references blog(id)
	on delete no action
	deferrable initially deferred;
alter table comment add constraint comment_event_fk foreign key (parent_id)
	where (parent_entity = 'event')
	references event(id)
	on update no action
	deferrable initially deferred;
-- data setup
insert into blog values (10);
insert into blog values (20);
insert into comment values(1, 'blog', 10);
insert into comment values(2, 'blog', 20);
insert into event values (10);
insert into event values (20);
insert into comment values(3, 'event', 10);
insert into comment values(4, 'event', 20);
-- update
begin;
update event set id = 22 where id = 20;
insert into event values (20);
commit;
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        10
  2 | blog          |        20
  3 | event         |        10
  4 | event         |        20
(4 rows)

-- delete
begin;
delete from blog where id = 10;
insert into blog values (10);
commit;
select * from comment order by id;
 id | parent_entity | parent_id 
----+---------------+-----------
  1 | blog          |        10
  2 | blog          |        20
  3 | event         |        10
  4 | event         |        20
(4 rows)

-- cleanup
delete from comment;
delete from event;
delete from blog;
alter table comment drop constraint comment_blog_fk;
alter table comment drop constraint comment_event_fk;
--
-- error handling
--
-- non-existent column
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (foo = 'blog')
	references blog(id);
ERROR:  column "foo" does not exist
-- wrong type
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity = 1234)
	references blog(id);
ERROR:  operator does not exist: commentable_entity = integer
DETAIL:  No operator of that name accepts the given argument types.
HINT:  You might need to add explicit type casts.
-- expression not boolean
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity::text)
	references blog(id);
ERROR:  argument of WHERE must be type boolean, not type text
--
-- validation when table is pre-populated
--
insert into comment values(1, 'blog', 10);
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references blog(id); -- fails
ERROR:  insert or update on table "comment" violates foreign key constraint "comment_blog_fk"
DETAIL:  Key (parent_id)=(10) is not present in table "blog".
insert into blog values(10);
alter table comment add constraint comment_blog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references blog(id);
--
-- the predicate round-trips through pg_get_constraintdef
--
select pg_get_constraintdef(oid) from pg_constraint
	where conrelid = 'comment'::regclass order by conname;
                                       pg_get_constraintdef                                       
--------------------------------------------------------------------------------------------------
 FOREIGN KEY (parent_id) WHERE ((parent_entity = 'blog'::commentable_entity)) REFERENCES blog(id)
 NOT NULL parent_entity
(2 rows)

\d comment
                       Table "public.comment"
    Column     |        Type        | Collation | Nullable | Default 
---------------+--------------------+-----------+----------+---------
 id            | integer            |           |          | 
 parent_entity | commentable_entity |           | not null | 
 parent_id     | integer            |           |          | 66
Foreign-key constraints:
    "comment_blog_fk" FOREIGN KEY (parent_id) WHERE (parent_entity = 'blog'::commentable_entity) REFERENCES blog(id)

-- feeding a deparsed definition back in reproduces it exactly
alter table comment add constraint comment_blog_fk2
	FOREIGN KEY (parent_id) WHERE ((parent_entity = 'blog'::commentable_entity))
	REFERENCES blog(id);
select pg_get_constraintdef(oid) from pg_constraint
	where conrelid = 'comment'::regclass and conname = 'comment_blog_fk2';
                                       pg_get_constraintdef                                       
--------------------------------------------------------------------------------------------------
 FOREIGN KEY (parent_id) WHERE ((parent_entity = 'blog'::commentable_entity)) REFERENCES blog(id)
(1 row)

alter table comment drop constraint comment_blog_fk2;
-- the predicate's columns are depended on, not just the key columns
alter table comment drop column parent_entity;
ERROR:  cannot drop column parent_entity of table comment because other objects depend on it
DETAIL:  constraint comment_blog_fk on table comment depends on column parent_entity of table comment
HINT:  Use DROP ... CASCADE to drop the dependent objects too.
alter table comment drop constraint comment_blog_fk;
--
-- combinations that are not supported yet
--
create table part_comment (
	id int4,
	parent_entity commentable_entity not null,
	parent_id int4
) partition by range (id);
alter table part_comment add constraint part_comment_blog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references blog(id); -- fails
ERROR:  foreign key with WHERE clause is not supported on partitioned table "part_comment"
create table part_blog (
	id int4 primary key
) partition by range (id);
alter table comment add constraint comment_partblog_fk foreign key (parent_id)
	where (parent_entity = 'blog')
	references part_blog(id); -- fails
ERROR:  foreign key with WHERE clause cannot reference partitioned table "part_blog"
drop table part_comment;
drop table part_blog;
-- cleanup
drop table comment;
drop table blog;
drop table event;
drop type commentable_entity;
